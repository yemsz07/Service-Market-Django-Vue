```gitignore
# =========================================================
# ServiceMarket - .gitignore
# Django Backend + Vue Frontend
# =========================================================


# =========================================================
# BACKEND - PYTHON / DJANGO
# =========================================================

# Python cache / compiled files
**/__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python virtual environments
venv/
.venv/
env/
Backend/venv/
Backend/.venv/

# Django local database
Backend/**/db.sqlite3

# Django uploaded media
Backend/**/media/

# Django collected static files
Backend/**/staticfiles/

# Python logs
*.log

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Build / distribution
build/
dist/
*.egg-info/


# =========================================================
# FRONTEND - VUE / NODE
# =========================================================

# Node dependencies
**/node_modules/

# Vue / Vite build output
**/dist/

# Nuxt / other frontend output (if used)
Frontend/.output/

# Frontend cache
Frontend/.vite/
Frontend/.nuxt/


# =========================================================
# ENVIRONMENT VARIABLES / SECRETS
# =========================================================

# Local environment files
.env
.env.local
.env.development
.env.test
.env.production

# Ignore all environment variants
.env.*

# BUT allow the safe template
!.env.example


# =========================================================
# IDE / EDITORS
# =========================================================

# Visual Studio Code
.vscode/

# JetBrains IDEs
.idea/

# Other editor files
*.swp
*.swo
*~


# =========================================================
# OPERATING SYSTEM FILES
# =========================================================

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini


# =========================================================
# TEMPORARY FILES
# =========================================================

*.tmp
*.temp
*.bak


# =========================================================
# FRONTEND ENVIRONMENT FILES
# =========================================================

# Vue / Vite environment files
Frontend/.env
Frontend/.env.local
Frontend/.env.development
Frontend/.env.test
Frontend/.env.production


# =========================================================
# OPTIONAL - LOCAL DEVELOPMENT FILES
# =========================================================

# Local test files / dumps
*.dump
*.sql

# Local Redis / cache files
*.rdb

